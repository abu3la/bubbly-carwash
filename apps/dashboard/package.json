{
  "name": "@bubbles/dashboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:dev": "VITE_API_URL=https://bubbles-api-dev.taz2886.workers.dev pnpm build && wrangler deploy --config wrangler.dev.jsonc",
    "deploy:dev:triggers": "wrangler triggers deploy --config wrangler.dev.jsonc",
    "lint": "eslint .",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router-dom": "^7.8.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.34.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.0",
    "wrangler": "^4.128.0"
  }
}
