{
  "name": "@bubbles/landing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy:dev": "NEXT_PUBLIC_DASHBOARD_URL=https://bubbles-dashboard-dev.taz2886.workers.dev opennextjs-cloudflare build && wrangler deploy --config wrangler.dev.jsonc",
    "deploy:dev:triggers": "wrangler triggers deploy --config wrangler.dev.jsonc",
    "lint": "eslint .",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@bubbles/design-tokens": "workspace:*",
    "next": "^15.5.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.6.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.34.0",
    "typescript": "^5.9.2",
    "wrangler": "^4.128.0"
  }
}
