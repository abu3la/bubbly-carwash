{
  "expo": {
    "name": "BubblesCarWash Driver",
    "slug": "bubblescarwash-driver",
    "scheme": "bubblescarwashdriver",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.bubblescarwash.driver",
      "supportsTablet": false
    },
    "android": {
      "package": "com.bubblescarwash.driver"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "./plugins/with-rnfirebase-ios-linkage",
      [
        "expo-image-picker",
        {
          "photosPermission": "نحتاج صور السيارة لتوثيق حالتها قبل الغسيل وبعده.",
          "cameraPermission": "نحتاج الكاميرا لتوثيق السيارة قبل الغسيل وبعده.",
          "microphonePermission": "نحتاج الميكروفون عند تسجيل فيديو توثيق 360 درجة."
        }
      ]
    ]
  }
}
